{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "public/**",
      "docs/**",
      "**/*.md",
      "**/*.log",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "storage.rules",
      "cors.json",
      "fix-cors.js",
      "design-system.html",
      "design-system.png",
      "firestore.indexes.json"
    ],
    "rewrites": [
      {
        "source": "/api/printerPoll",
        "function": {
          "functionId": "printerPoll",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
